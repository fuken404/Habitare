# =================================
#             APLICACIÓN
# =================================

APP_NAME=Habitare API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# =================================
#           BASE DE DATOS
# =================================

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- PgAdmin ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

# =================================
#             BACKEND
# =================================

BACKEND_PORT=8000

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60